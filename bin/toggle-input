#!/bin/sh

# Check if a device ID was provided
if [ -z "$1" ]; then
    echo "Error: No device ID provided"
    echo "Usage: $0 <device_id>"
    exit 1
fi

# Set device ID from first argument
DEVICE_ID=$1

# Get the current state of the touchpad with the provided device ID
if xinput list-props $DEVICE_ID | grep -q 'Device Enabled.*1'; then
    # If enabled, disable it
    xinput disable $DEVICE_ID
    echo "Device $DEVICE_ID disabled"
else
    # If disabled, enable it (with 1 second delay)
    sleep 1 && xinput enable $DEVICE_ID
    echo "Device $DEVICE_ID enabled"
fi

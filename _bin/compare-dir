from pathlib import Path
from tabulate import tabulate # type: ignore
import time
import sys

# Hardcoded paths — change as needed
# SRC = Path("/run/media/jake/JUDY-DRIVE")
# DST = Path("/mnt/zas/JUDY")
if len(sys.argv) < 2:
    exit("Usage: compare <src> <dst>")
else:
    SRC = sys.argv[1]
    DST = sys.argv[2]

def get_folder_sizes(base_path, _):
    """Return dict: {folder_name: total_size_bytes} with progress output, skipping dot folders"""
    folder_sizes = {}
    entries = sorted([
        e for e in Path(base_path).iterdir()
        if e.is_dir() and not e.name.startswith('.')
    ])
    total = len(entries)

    print(f"\n🔍 Scanning folders in: {base_path} ({total} folders, dot-folders skipped)\n")
    for idx, entry in enumerate(entries, start=1):
        print(f"  [{idx}/{total}] Scanning '{entry.name}'...", end='', flush=True)
        total_size = sum(f.stat().st_size for f in entry.rglob('*') if f.is_file())
        folder_sizes[entry.name] = total_size
        print(f" done ({format_size(total_size)})")
    return folder_sizes

def format_size(bytes_size):
    """Convert bytes to human-readable string."""
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if bytes_size < 1024:
            return f"{bytes_size:.2f} {unit}"
        bytes_size /= 1024
    return f"{bytes_size:.2f} PB"

# Start timer
start_time = time.time()

# Get sizes with progress
src_sizes = get_folder_sizes(SRC, "Source")
dst_sizes = get_folder_sizes(DST, "Destination")

# Combine all folders
all_folders = sorted(set(src_sizes.keys()) | set(dst_sizes.keys()))

# Build table
table = []
for folder in all_folders:
    src_size = format_size(src_sizes.get(folder, 0)) if folder in src_sizes else "❌ Missing"
    dst_size = format_size(dst_sizes.get(folder, 0)) if folder in dst_sizes else "❌ Missing"
    table.append([folder, src_size, dst_size])

# Show final table
print("\n📊 Folder Size Comparison:\n")
print(tabulate(table, headers=["Folder", "Source Size", "Destination Size"], tablefmt="github"))

# Summary
elapsed = time.time() - start_time
print(f"\n✅ Done in {elapsed:.1f} seconds.\n")

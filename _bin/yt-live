#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "yt-dlp>=2025.2.19",
# ]
# ///

import subprocess
import sys
import argparse
from urllib.parse import urlparse, parse_qs


channels = {
    "lofi": "jfKfPfyJRdk",
    "rock": "2Sn6nqruOB8",
    "pop": "8M0AvPvPg0A",
    "house": "jfKfPfyJRdk",
    "limit": "D4gm0xA6t9c",
    "top": "8M0AvPvPg0A",
}


def check_dependencies():
    try:
        subprocess.run(
            ["mpv", "--version"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError:
        print("Error: mpv is not installed. Please install it first.")
        print("  - Linux: sudo apt install mpv")
        print("  - macOS: brew install mpv")
        print("  - Windows: choco install mpv")
        return False

    try:
        subprocess.run(
            ["yt-dlp", "--version"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError:
        print("Error: yt-dlp is not installed. Please install it first.")
        print("  - All platforms: pip install yt-dlp")
        return False

    return True


def extract_video_id(url):
    if not url:
        return None

    parsed_url = urlparse(url)

    if parsed_url.netloc in ["youtube.com", "www.youtube.com", "m.youtube.com"]:
        query_params = parse_qs(parsed_url.query)
        if "v" in query_params:
            return query_params["v"][0]

    elif parsed_url.netloc == "youtu.be":
        return parsed_url.path.lstrip("/")

    elif len(url) == 11 and all(
        c in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
        for c in url
    ):
        return url

    return None


def play_livestream(video_id, audio_only=True):
    url = f"https://www.youtube.com/watch?v={video_id}"

    mpv_command = ["mpv"]

    if audio_only:
        mpv_command.append("--no-video")

    mpv_command.extend(
        [
            "--cache=yes",
            "--cache-secs=30",
            "--demuxer-max-bytes=500M",
            "--force-seekable=no",
        ]
    )

    mpv_command.append(url)

    print("\nStarting YouTube livestream...")
    print(f"Playing: {url}")
    print("Controls: q (quit), m (mute/unmute), 9 0 (decrease/increase volume)")

    try:
        subprocess.run(mpv_command)
    except KeyboardInterrupt:
        print("\nStopping YouTube livestream...")
    except Exception as e:
        print(f"\nError playing livestream: {e}")


def search_youtube_livestreams(query):
    search_query = query.replace(" ", "+")
    command = [
        "yt-dlp",
        "ytsearch5:live " + search_query,
        "--flat-playlist",
        "--dump-json",
    ]

    try:
        result = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=True,
        )

        streams = []
        for line in result.stdout.strip().split("\n"):
            if line:
                try:
                    import json

                    data = json.loads(line)
                    if "live_status" in data and data["live_status"] == "is_live":
                        streams.append(
                            {
                                "id": data.get("id"),
                                "title": data.get("title"),
                                "channel": data.get(
                                    "channel", data.get("uploader", "Unknown")
                                ),
                            }
                        )
                except json.JSONDecodeError:
                    continue
                except KeyError:
                    streams.append(
                        {
                            "id": data.get("id"),
                            "title": data.get("title"),
                            "channel": data.get(
                                "channel", data.get("uploader", "Unknown")
                            ),
                        }
                    )

        return streams
    except subprocess.CalledProcessError as e:
        print(f"Error searching: {e.stderr}")
        return []


def interactive_mode():
    while True:
        print("\n====== YouTube Livestream Player ======\n")
        print("1. Play from URL")
        print("2. Search for livestreams")
        print("3. Play lofi")
        print("4. Play rock")
        print("5. Play pop")
        print("6. Play house")
        print("7. Play limit")
        print("8. Play top")
        print("Q. Exit")

        choice = input().strip()

        if choice == "1":
            url = input("Enter YouTube livestream URL: ").strip()
            video_id = extract_video_id(url)

            if not video_id:
                print("Invalid YouTube URL.")
                continue

            audio_only = input("Audio only? (y/n): ").lower() != "n"
            play_livestream(video_id, audio_only)

        elif choice == "2":
            query = input("Enter search term for livestreams: ").strip()
            print("Searching for livestreams...")
            streams = search_youtube_livestreams(query)

            if not streams:
                print("No livestreams found. Try different keywords.")
                continue

            print("\nSearch Results:")
            for i, stream in enumerate(streams, 1):
                print(f"{i}. {stream['title']} - by {stream['channel']}")

            selection = input(
                "\nSelect a livestream (number) or 0 to go back: "
            ).strip()
            try:
                selection = int(selection)
                if 1 <= selection <= len(streams):
                    video_id = streams[selection - 1]["id"]
                    audio_only = input("Audio only? (y/n): ").lower() != "n"
                    play_livestream(video_id, audio_only)
            except ValueError:
                print("Invalid selection.")

        elif choice == "3":
            print("Starting lofi hip hop radio...")
            play_livestream(channels["lofi"], audio_only=True)

        elif choice == "4":
            print("Starting rock...")
            play_livestream(channels["rock"], audio_only=True)

        elif choice == "5":
            print("Starting pop...")
            play_livestream(channels["pop"], audio_only=True)

        elif choice == "6":
            print("Starting house...")
            play_livestream(channels["house"], audio_only=True)

        elif choice == "7":
            print("Starting limit...")
            play_livestream(channels["limit"], audio_only=True)

        elif choice == "8":
            print("Starting top...")
            play_livestream(channels["top"], audio_only=True)

        elif choice == "q" or choice == "Q":
            print("Exiting...")
            break
        else:
            print("Invalid choice. Please try again.")


def main():
    parser = argparse.ArgumentParser(description="Play YouTube livestreams in terminal")
    parser.add_argument("-u", "--url", help="YouTube livestream URL")
    parser.add_argument(
        "-v",
        "--video",
        action="store_true",
        help="Enable video (default is audio only)",
    )
    parser.add_argument(
        "-i", "--interactive", action="store_true", help="Interactive mode"
    )
    parser.add_argument("--search", help="Search for YouTube livestreams")
    parser.add_argument("--lofi", action="store_true", help="Play lofi")
    parser.add_argument("--rock", action="store_true", help="Play rock")
    parser.add_argument("--pop", action="store_true", help="Play pop")
    parser.add_argument("--house", action="store_true", help="Play house")
    parser.add_argument("--limit", action="store_true", help="Play limitless")
    parser.add_argument("--top", action="store_true", help="Play top hits")

    args = parser.parse_args()

    if not check_dependencies():
        sys.exit(1)

    if args.interactive:
        interactive_mode()
    elif args.search:
        streams = search_youtube_livestreams(args.search)
        if not streams:
            print("No livestreams found.")
            sys.exit(0)

        print("\nSearch Results:")
        for i, stream in enumerate(streams, 1):
            print(f"{i}. {stream['title']} - by {stream['channel']}")

        selection = input("\nSelect a livestream (number) or 0 to cancel: ").strip()
        try:
            selection = int(selection)
            if 1 <= selection <= len(streams):
                video_id = streams[selection - 1]["id"]
                play_livestream(video_id, not args.video)
        except ValueError:
            print("Invalid selection.")
    elif args.lofi:
        play_livestream(channels["lofi"], not args.video)
    elif args.rock:
        play_livestream(channels["rock"], not args.video)
    elif args.pop:
        play_livestream(channels["pop"], not args.video)
    elif args.house:
        play_livestream(channels["house"], not args.video)
    elif args.limit:
        play_livestream(channels["limit"], not args.video)
    elif args.top:
        play_livestream(channels["top"], not args.video)
    elif args.url:
        video_id = extract_video_id(args.url)
        if video_id:
            play_livestream(video_id, not args.video)
        else:
            print("Invalid YouTube URL.")
    else:
        parser.print_help()


if __name__ == "__main__":
    main()


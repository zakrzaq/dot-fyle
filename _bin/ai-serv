import typing as t
import httpx
import os
from enum import Enum
from collections import deque
from flask import Flask, request, jsonify

# --- Configuration ---
class Provider(Enum):
    OPENAI = "openai"
    GEMINI = "gemini"
    ANTHROPIC = "anthropic"
    DEEPSEEK = "deepseek"
    OLLAMA = "ollama"

# You would typically load these from environment variables or a config file
API_KEYS: t.Dict[Provider, str] = {
    Provider.OPENAI: os.environ.get("OPENAI_API_KEY", ""),
    Provider.GEMINI: os.environ.get("GEMINI_API_KEY", ""),
    Provider.ANTHROPIC: os.environ.get("ANTHROPIC_API_KEY", ""),
    Provider.DEEPSEEK: os.environ.get("DEEPSEEEK_API_KEY", ""),  # Or OpenRouter key
    Provider.OLLAMA: "ollama",  # Ollama doesn't use an API key in the traditional sense, but you might have a URL
}

# --- Abstract Base Class for LLM Interaction ---
class LLMClient:
    """
    Abstract base class for interacting with Large Language Models.
    """
    def __init__(self, api_key: str):
        """
        Initializes the LLM client with the API key.
        Args:
            api_key (str): The API key for the LLM provider.
        """
        self.api_key = api_key

    def get_models(self) -> t.List[str]:
        """
        Retrieves a list of available models from the LLM provider.
        Returns:
            t.List[str]: A list of model names.
        """
        raise NotImplementedError("Subclasses must implement get_models()")

    def chat(self, model: str, messages: t.List[t.Dict[str, str]]) -> str:
        """
        Sends a chat request to the LLM provider and returns the response.
        Args:
            model (str): The name of the model to use.
            messages (t.List[t.Dict[str, str]]): A list of message dictionaries
                (e.g., [{"role": "user", "content": "What is the capital of France?"}]).
        Returns:
            str: The LLM's response.
        """
        raise NotImplementedError("Subclasses must implement chat()")

    def get_embeddings(self, model: str, text: str) -> t.List[float]:
        """
        Generates an embedding for the given text.
        Args:
            model (str): The name of the model to use.
            text (str): The text to embed.
        Returns:
            t.List[float]: The embedding vector.
        """
        raise NotImplementedError("Subclasses must implement get_embeddings()")

# --- Concrete Implementations for Each Provider ---
class OpenAIClient(LLMClient):
    """
    Client for interacting with the OpenAI API.
    """
    def __init__(self, api_key: str):
        super().__init__(api_key)
        import openai
        openai.api_key = self.api_key

    def get_models(self) -> t.List[str]:
        """Retrieves available OpenAI models."""
        import openai
        try:
            response = openai.Model.list()  # Use the sync version
            models = [model.id for model in response.data]
            return models
        except Exception as e:
            print(f"Error fetching OpenAI models: {e}")
            return []

    def chat(self, model: str, messages: t.List[t.Dict[str, str]]) -> str:
        """Sends a chat request to OpenAI."""
        from openai import OpenAI
        try:
            client = OpenAI()

            response = client.responses.create(
                model=model,
                input=messages
            )

            return response.output_text
        except Exception as e:
            print(f"Error in OpenAI chat: {e}")
            return f"OpenAI Error: {e}"

    def get_embeddings(self, model: str, text: str) -> t.List[float]:
        """Generates an embedding for the given text using OpenAI."""
        import openai
        try:
            response = openai.Embedding.create(  # Use sync version
                model=model,
                input=text,
            )
            return response.data[0].embedding
        except Exception as e:
            print(f"Error getting OpenAI embedding: {e}")
            return []


class GeminiClient(LLMClient):
    """
    Client for interacting with the Google Gemini API.
    """
    def __init__(self, api_key: str):
        super().__init__(api_key)
        import google.generativeai as genai
        genai.configure(api_key=self.api_key)

    def get_models(self) -> t.List[str]:
        """Retrieves available Gemini models."""
        import google.generativeai as genai
        try:
            models = [m.name for m in genai.list_models()]
            return models
        except Exception as e:
            print(f"Error fetching Gemini models: {e}")
            return []

    def chat(self, model: str, messages: t.List[t.Dict[str, str]]) -> str:
        """Sends a chat request to Gemini."""
        import google.generativeai as genai
        try:
            genai_model = genai.GenerativeModel(model)
            # Convert messages to the format expected by Gemini
            prompt = ""
            for message in messages:
                if message["role"] == "user":
                    prompt += f"User: {message['content']}\n"
                elif message["role"] == "assistant":
                    prompt += f"Assistant: {message['content']}\n"
            response = genai_model.generate_content(prompt) # Use sync
            return response.text.strip()
        except Exception as e:
            print(f"Error in Gemini chat: {e}")
            return f"Gemini Error: {e}"

    def get_embeddings(self, model: str, text: str) -> t.List[float]:
        """Generates an embedding for the given text using Gemini."""
        import google.generativeai as genai
        try:
            embedding_model = genai.GenerativeModel(model)  # Use the same model, or a dedicated embedding model.
            response = embedding_model.embed_content(content=text)
            return response.embedding.tolist()
        except Exception as e:
            print(f"Error getting Gemini embedding: {e}")
            return []


class AnthropicClient(LLMClient):
    """
    Client for interacting with the Anthropic API.
    """
    def __init__(self, api_key: str):
        super().__init__(api_key)
        from anthropic import Anthropic  # Use the sync version
        self.client = Anthropic(api_key=self.api_key)

    def get_models(self) -> t.List[str]:
        """
        Retrieves available Anthropic models.  Anthropic doesn't have a direct "list models" API.
        This is a placeholder that returns some known model names.
        """
        return ["claude-3-opus-20240229", "claude-3-sonnet-20240229", "claude-2.1", "claude-2.0", "claude-1.3", "claude-1.2"]

    def chat(self, model: str, messages: t.List[t.Dict[str, str]]) -> str:
        """Sends a chat request to Anthropic."""
        from anthropic import HUMAN_PROMPT, AI_PROMPT
        try:
            # Anthropic expects a single prompt, not a list of messages in the same way as OpenAI.
            prompt = ""
            for message in messages:
                if message["role"] == "user":
                    prompt += f"{HUMAN_PROMPT} {message['content']} "
                elif message["role"] == "assistant":
                    prompt += f"{AI_PROMPT} {message['content']} "
            prompt += AI_PROMPT  # Ensure the prompt ends with the AI prompt

            response = self.client.messages.create(  # Use the sync version
                model=model,
                max_tokens=1024,  # Or another appropriate value
                messages=[{"role": "user", "content": prompt}] #anthropic messages api expects only user role
            )
            return response.content[0].text.strip() # Access the text within the content list
        except Exception as e:
            print(f"Error in Anthropic chat: {e}")
            return f"Anthropic Error: {e}"

    def get_embeddings(self, model: str, text: str) -> t.List[float]:
        """Generates embeddings for the given text using Anthropic."""
        # Anthropic doesn't have a direct embedding API. We'll use the chat API and prompt engineering.
        # This is not ideal, but it's the best we can do for now. This will also be slow.
        prompt = f"{HUMAN_PROMPT} Embed the following text: {text} {AI_PROMPT} [embedding vector]"
        try:
            response = self.client.messages.create(
                model=model,
                max_tokens=512,
                messages=[{"role": "user", "content": prompt}]
            )
            response_text = response.content[0].text.strip()
            # Extract the embedding vector from the response. This is very brittle.
            start_index = response_text.find("[")
            end_index = response_text.find("]")
            if start_index == -1 or end_index == -1:
                print(f"Embedding extraction failed: {response_text}")
                return []
            embedding_str = response_text[start_index + 1:end_index]
            embedding_values = [float(x.strip()) for x in embedding_str.split(",")]
            return embedding_values
        except Exception as e:
            print(f"Error getting Anthropic embedding: {e}")
            return []


class DeepSeekClient(LLMClient):
    """
    Client for interacting with the DeepSeek API (via OpenRouter).
    """
    def __init__(self, api_key: str):
        super().__init__(api_key)
        import httpx # Use httpx for synchronous operations
        self.client = httpx.Client() # Initialize synchronous httpx client

    def get_models(self) -> t.List[str]:
        """
        Retrieves available DeepSeek models (via OpenRouter).
        OpenRouter doesn't have a direct way to list *only* DeepSeek models.
        This returns a list of some known DeepSeek models.
        """
        return ["deepseek/deepseek-chat", "deepseek/deepseek-chat:free", "deepseek/deepseek-coder"]

    def chat(self, model: str, messages: t.List[t.Dict[str, str]]) -> str:
        """Sends a chat request to DeepSeek (via OpenRouter)."""
        url = "https://openrouter.ai/api/v1/chat/completions"
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json",
        }
        data = {
            "model": model,
            "messages": messages,
        }
        try:
            response = self.client.post(url, json=data, headers=headers)
            response.raise_for_status()  # Raise HTTPError for bad responses
            return response.json()["choices"][0]["message"]["content"].strip()
        except httpx.HTTPStatusError as e: # Changed from requests.exceptions.HTTPStatusError
            print(f"HTTP error in DeepSeek chat: {e.response.status_code}, {e.response.text}")
            return f"DeepSeek HTTP Error: {e.response.status_code}"
        except Exception as e:
            print(f"Error in DeepSeek chat: {e}")
            return f"DeepSeek Error: {e}"

    def get_embeddings(self, model: str, text: str) -> t.List[float]:
        """Gets embeddings from DeepSeek via OpenRouter"""
        url = "https://openrouter.ai/api/v1/embeddings"
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json",
        }
        data = {
            "model": model,
            "input": text,
        }

        try:
            response = self.client.post(url, json=data, headers=headers)
            response.raise_for_status()
            return response.json()["data"][0]["embedding"]
        except httpx.HTTPStatusError as e: # Changed from requests.exceptions.HTTPStatusError
            print(f"HTTP error getting embeddings from DeepSeek: {e.response.status_code}, {e.response.text}")
            return []
        except Exception as e:
            print(f"Error getting embeddings from DeepSeek: {e}")
            return []


class OllamaClient(LLMClient):
    """
    Client for interacting with the Ollama API.
    """
    def __init__(self, api_key: str):  # Ollama doesn't use a traditional API key, but we include it for consistency
        super().__init__(api_key)
        import httpx # Use httpx for synchronous operations
        self.client = httpx.Client() # Initialize synchronous httpx client

    def get_models(self) -> t.List[str]:
        """Retrieves available Ollama models."""
        url = "http://localhost:11434/api/tags"  # Default Ollama API endpoint
        try:
            response = self.client.get(url)
            response.raise_for_status()
            data = response.json()
            models = [model["name"] for model in data["models"]]
            return models
        except httpx.HTTPStatusError as e: # Changed from requests.exceptions.HTTPStatusError
            print(f"HTTP error fetching Ollama models: {e.response.status_code}, {e.response.text}")
            return []
        except Exception as e:
            print(f"Error fetching Ollama models: {e}")
            return []

    def chat(self, model: str, messages: t.List[t.Dict[str, str]]) -> str:
        """Sends a chat request to Ollama."""
        url = "http://localhost:11434/api/chat"  # Default Ollama API endpoint
        data = {
            "model": model,
            "messages": messages,
        }
        try:
            response = self.client.post(url, json=data)
            response.raise_for_status()
            return response.json()["message"]["content"].strip()
        except httpx.HTTPStatusError as e: # Changed from requests.exceptions.HTTPStatusError
            print(f"HTTP error in Ollama chat: {e.response.status_code}, {e.response.text}")
            return f"Ollama HTTP Error: {e.response.status_code}"
        except Exception as e:
            print(f"Error in Ollama chat: {e}")
            return f"Ollama Error: {e}"

    def get_embeddings(self, model: str, text: str) -> t.List[float]:
        """Generates an embedding for the given text using Ollama."""
        url = "http://localhost:11434/api/embeddings"  # Ollama embedding endpoint
        data = {
            "model": model,
            "prompt": text,
        }
        try:
            response = self.client.post(url, json=data)
            response.raise_for_status()
            return response.json()["embedding"]
        except httpx.HTTPStatusError as e: # Changed from requests.exceptions.HTTPStatusError
            print(f"HTTP error getting Ollama embedding: {e.response.status_code}, {e.response.text}")
            return []
        except Exception as e:
            print(f"Error getting Ollama embedding: {e}")
            return []

# --- Main Application ---
class ChatApp:
    """
    Main application class for the multi-LLM chat interface.
    """
    def __init__(self):
        """
        Initializes the chat application.
        """
        self.providers: t.Dict[Provider, LLMClient] = {}
        self.available_models: t.Dict[Provider, t.List[str]] = {}
        self.vector_store: t.Optional["faiss.IndexFlatL2"] = None
        self.embedding_model: str = ""
        self.chat_histories: t.Dict[str, deque] = {}  # {session_id: deque of messages}
        self.max_history_len = 5  # Maximum number of messages to keep in history

    def initialize(self):
        """
        Initializes the LLM clients, fetches available models, and initializes FAISS.
        """
        for provider, api_key in API_KEYS.items():
            if provider == Provider.OLLAMA:
                self.providers[provider] = OllamaClient(api_key)
            elif api_key:
                if provider == Provider.OPENAI:
                    self.providers[provider] = OpenAIClient(api_key)
                elif provider == Provider.GEMINI:
                    self.providers[provider] = GeminiClient(api_key)
                elif provider == Provider.ANTHROPIC:
                    self.providers[provider] = AnthropicClient(api_key)
                elif provider == Provider.DEEPSEEK:
                    self.providers[provider] = DeepSeekClient(api_key)
            else:
                print(f"API key for {provider.value} is missing. Skipping initialization.")

        # Fetch models synchronously
        for provider in self.providers:
            self.fetch_models(provider)

        self.init_vector_store()

    def fetch_models(self, provider: Provider):
        """
        Fetches the models for a given provider and stores them in the
        `available_models` dictionary.
        Args:
            provider (Provider): The provider enum.
        """
        client = self.providers[provider]
        models = client.get_models()
        self.available_models[provider] = models
        print(f"Available models for {provider.value}: {models}")

    def init_vector_store(self):
        """Initializes the FAISS vector store."""
        try:
            import faiss
            import numpy as np
            self.embedding_model = "text-embedding-ada-002"
            embedding_dimension = 1536
            self.vector_store = faiss.IndexFlatL2(embedding_dimension)
            print("FAISS vector store initialized.")
        except ImportError:
            print("FAISS or numpy not installed. Vector search will be disabled.")
            self.vector_store = None

    def get_chat_history(self, session_id: str) -> deque:
        """
        Retrieves the chat history for a given session ID.
        Creates a new history if one doesn't exist.
        """
        if session_id not in self.chat_histories:
            self.chat_histories[session_id] = deque(maxlen=self.max_history_len)
        return self.chat_histories[session_id]

    def process_message(self, provider: Provider, model: str, message: str, session_id: str) -> str:
        """
        Processes a user message, including embedding generation, vector search,
        and chat history management.
        Args:
            provider (Provider): The provider enum.
            model (str): The name of the model to use.
            message (str): The user's message.
            session_id (str): The user's session ID.
        Returns:
            str: The LLM's response.
        """
        client = self.providers[provider]
        history = self.get_chat_history(session_id)

        # Generate embedding and store in FAISS
        if self.vector_store:
            embedding = client.get_embeddings(self.embedding_model, message)
            if embedding:
                import numpy as np
                self.vector_store.add(np.array([embedding], dtype=np.float32))
                print("Embedding added to vector store.")

        # Perform similarity search
        if self.vector_store:
            embedding = client.get_embeddings(self.embedding_model, message)
            if embedding:
                import numpy as np
                # Ensure the embedding is a 2D array for FAISS search
                query_embedding = np.array([embedding], dtype=np.float32)
                # Check if the index is not empty before searching
                if self.vector_store.ntotal > 0:
                    _, I = self.vector_store.search(query_embedding, min(5, self.vector_store.ntotal))  # Search top 5 or less if not enough
                    print(f"FAISS search results: {I}")
                    # In a real application, use the results (I) to fetch relevant information
                    # and include it in the prompt to the LLM. For this example, we'll just
                    # add a placeholder to the history.
                    history.append({"role": "system", "content": "Relevant information from vector store."})
                else:
                    print("FAISS index is empty, skipping search.")


        # Include chat history in the prompt
        messages = list(history)
        messages.append({"role": "user", "content": message})
        response = client.chat(model, messages)
        history.append({"role": "assistant", "content": response})

        return response


# --- Flask Integration ---
app = Flask(__name__)
chat_app = ChatApp()

@app.route("/chat", methods=["POST"])
def chat():
    """
    Endpoint for handling chat requests.
    """
    data = request.get_json()
    provider_name = data.get("provider")
    model = data.get("model")
    message = data.get("message")
    session_id = data.get("session_id")

    if not all([provider_name, model, message, session_id]):
        return jsonify({"error": "Missing parameters"}), 400

    try:
        provider = Provider(provider_name.lower())
        if provider not in chat_app.providers:
            return jsonify({"error": "Invalid provider"}), 400

        response = chat_app.process_message(provider, model, message, session_id)
        return jsonify({"response": response}), 200
    except ValueError:
        return jsonify({"error": "Invalid provider name"}), 400
    except Exception as e:
        print(f"Error processing chat request: {e}")
        return jsonify({"error": str(e)}), 500

@app.route("/models", methods=["GET"])
def get_models():
    """
    Endpoint to get available models for a provider
    """
    provider_name = request.args.get("provider")
    if not provider_name:
        return jsonify({"error": "Missing provider parameter"}), 400
    try:
        provider = Provider(provider_name.lower())
        if provider not in chat_app.providers:
            return jsonify({"error": "Invalid provider"}), 400
        models = chat_app.available_models.get(provider, [])
        return jsonify({"models": models}), 200
    except ValueError:
        return jsonify({"error": "Invalid provider name"}), 400

@app.route("/health", methods=["GET"])
def health_check():
    """
    Endpoint for health check.
    """
    return jsonify({"status": "ok"}), 200

def run_app():
    """
    Initializes the chat application and runs the Flask server.
    """
    chat_app.initialize() # Initialize the ChatApp synchronously
    app.run(debug=True, host="0.0.0.0", port=7070) # Run Flask app on port 7070

if __name__ == "__main__":
    run_app()

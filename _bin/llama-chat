import requests
import json
import argparse
import subprocess
import platform
import sys
from urllib.parse import urlparse
from pygments import highlight
from pygments.lexers import get_lexer_by_name
from pygments.formatters import TerminalTrueColorFormatter
from prompt_toolkit import prompt
from prompt_toolkit.completion import WordCompleter
import re


parser = argparse.ArgumentParser(
                    prog='LLama chat',
                    description='Interact with local and remote ollama instances',
                    epilog='by Zakrzaq')

parser.add_argument('-H', '--host', help='Host name: local or oberon', default='local')
args = parser.parse_args()

constants = {
        "oberon_url": "http://192.168.21.20:11434/api",
        "local_url": "http://localhost:11434/api"
        }

settings = {}
settings['url'] = constants[args.host + '_url']


def is_host_reachable(host: str = settings["url"]) -> bool:
    """Check if a route to the host exists using ping."""
    url = urlparse(host).hostname
    try:
        ping_cmd = ["ping", "-c", "1", url] if platform.system() != "Windows" else ["ping", "-n", "1", url]

        result = subprocess.run(ping_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        
        return result.returncode == 0  
    except Exception as e:
        print(f"Error checking host route: {e}")
        return False


def models_list():
    url = settings['url'] + "/tags"
    try:
        response = requests.get(url)
        response.raise_for_status()
        models = response.json().get("models", [])
        models_list = [model["name"] for model in models]
        print(f"Available models: {models_list}")
        return models_list
    except requests.RequestException as e:
        print(f"Error fetching models: {e}")
        return []


def select_model():
    models = models_list()
    if not models:
        print("No models available.")
        return None

    model_completer = WordCompleter(models, ignore_case=True)
    selected_model = prompt("Select a model: ", completer=model_completer)
    
    if selected_model in models:
        return selected_model
    else:
        print("Invalid selection.")
        return None


def highlight_code(text):
    code_block_pattern = r'```(\w+)?\n([\s\S]*?)\n```'
    
    def replace_with_highlighted(match):
        language = match.group(1) or 'text'
        code = match.group(2)
        try:
            lexer = get_lexer_by_name(language, stripall=True)
            formatter = TerminalTrueColorFormatter(style='nord')
            return highlight(code, lexer, formatter)
        except Exception:
            # Fallback if language not recognized
            return f"\n{code}\n"
    
    # Replace code blocks with highlighted versions
    highlighted_text = re.sub(code_block_pattern, replace_with_highlighted, text)
    return highlighted_text


def main():
    if not is_host_reachable():
        sys.exit("Host is not reachable.")

    selected_model = None
    while not selected_model:
        selected_model = select_model()
    conversation_history = []
    
    print(f"Chat with {selected_model} (type 'exit' to quit)")
    
    while True:
        user_input = input("\nYou: ")
        
        if user_input.lower() in ['exit', 'quit', 'bye']:
            print("Exiting chat...")
            break
        
        conversation_history.append({"role": "user", "content": user_input})
        
        url = settings['url'] + "/chat"
        payload = {
            "model": selected_model,
            "messages": conversation_history
        }
        
        print("\nAssistant: ", end="\n", flush=True)
        
        assistant_response = ""
        with requests.post(url, json=payload, stream=True) as response:
            if response.status_code != 200:
                print(f"Failed to fetch response: {response.status_code}")
                continue
            
            current_code_block = ""
            in_code_block = False
            code_language = ""
            
            for line in response.iter_lines():
                if line:
                    try:
                        api_response = json.loads(line.decode('utf-8'))
                        
                        if "message" in api_response:
                            chunk = api_response["message"].get("content", "")
                            assistant_response += chunk
                            print(chunk, end="", flush=True)
                        elif "done" in api_response and api_response["done"]:
                            if in_code_block:
                                print("```")
                            break
                    except json.JSONDecodeError:
                        print(f"Error parsing JSON: {line.decode('utf-8')}")
        
        conversation_history.append({"role": "assistant", "content": assistant_response})
        
        # After receiving the entire response, show syntax highlighted version
        if "```" in assistant_response:
            print("\n\nHere's the response with syntax highlighting:")
            print(highlight_code(assistant_response))

if __name__ == "__main__":

    main()

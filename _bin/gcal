import datetime
import pickle
from googleapiclient.discovery import build
from google_auth_oauthlib.flow import InstalledAppFlow
from google.auth.transport.requests import Request
from rich.console import Console
from rich.table import Table
from rich.panel import Panel
from rich import box
from rich.prompt import IntPrompt
from pathlib import Path

CONFIG_PATH = Path.home() / ".config" / "gcal"
if not CONFIG_PATH.exists():
    CONFIG_PATH.mkdir(parents=True, exist_ok=True)
TOKEN_PATH = CONFIG_PATH / "token.pickle"
CREDS_PATH = CONFIG_PATH / "credentials.json"


class App:
    scope = ["https://www.googleapis.com/auth/calendar"]
    creds = None
    console = Console()
    days = 14


    def __init__(self):
        self._get_credentials()
        self.service = self._get_calendar_service()


    def _get_credentials(self):
        if TOKEN_PATH.exists():
            print("Loading credentials from file")
            with open(TOKEN_PATH, "rb") as token:
                self.creds = pickle.load(token)

        if not self.creds or not self.creds.valid:
            if self.creds and self.creds.expired and self.creds.refresh_token:
                self.creds.refresh(Request())
            else:
                flow = InstalledAppFlow.from_client_secrets_file(CREDS_PATH, self.scope)
                self.creds = flow.run_local_server(port=0)
                
                with open(TOKEN_PATH, "wb") as token:
                    pickle.dump(self.creds, token)


    def _get_calendar_service(self):
        """Get an authorized Google Calendar service."""
        return build("calendar", "v3", credentials=self.creds)


    def get_calendar_list(self):
        """Get list of all available calendars."""
        service = self.service
        calendars_result = service.calendarList().list().execute()
        calendars = calendars_result.get("items", [])
        return calendars


    def display_calendars(self, calendars):
        """Display all available calendars in a formatted table."""
        if not calendars:
            self.console.print("[bold red]No calendars found.[/]")
            return

        table = Table(title="Your Calendars", box=box.ROUNDED)
        table.add_column("#", style="cyan", justify="right")
        table.add_column("Calendar Name", style="green")
        table.add_column("Calendar ID", style="yellow")
        table.add_column("Primary", style="magenta", justify="center")

        for i, calendar in enumerate(calendars, 1):
            is_primary = "✓" if calendar.get("primary", False) else ""
            table.add_row(str(i), calendar["summary"], calendar["id"], is_primary)

        self.console.print(table)


    def get_events(self, days=7, calendar_id="primary"):
        """Get upcoming events from specified calendar."""
        service = self.service 

        now = datetime.datetime.utcnow().isoformat() + "Z"  # 'Z' indicates UTC time
        end_date = (
            datetime.datetime.utcnow() + datetime.timedelta(days=days)
        ).isoformat() + "Z"

        self.console.print(f"[yellow]Getting events for the next {days} days...[/]")

        events_result = (
            service.events()
            .list(
                calendarId=calendar_id,
                timeMin=now,
                timeMax=end_date,
                singleEvents=True,
                orderBy="startTime",
            )
            .execute()
        )

        return events_result.get("items", [])


    def get_all_events(self, days=7, calendars=None):
        """Get events from all calendars."""
        if not calendars:
            calendars = self.get_calendar_list()

        all_events = []
        for calendar in calendars:
            calendar_id = calendar["id"]
            calendar_name = calendar["summary"]
            self.console.print(f"Fetching events from [cyan]{calendar_name}[/]...")
            events = self.get_events(days, calendar_id)

            for event in events:
                event["calendarName"] = calendar_name
                event["calendarId"] = calendar_id

            all_events.extend(events)

        all_events.sort(key=lambda x: x["start"].get("dateTime", x["start"].get("date")))
        return all_events


    def display_events(self, events):
        """Display events in a formatted table."""
        if not events:
            self.console.print("[bold red]No upcoming events found.[/]")
            return

        table = Table(title="Your Calendar Events", box=box.ROUNDED)
        table.add_column("Date", style="cyan")
        table.add_column("Time", style="green")
        table.add_column("Event", style="yellow")
        table.add_column("Calendar", style="blue")
        table.add_column("All Day", style="magenta", justify="center")

        for event in events:
            start = event["start"].get("dateTime", event["start"].get("date"))
            is_all_day = "dateTime" not in event["start"]

            if is_all_day:
                # Format the date for all-day events
                date_obj = datetime.datetime.strptime(start, "%Y-%m-%d")
                date_str = date_obj.strftime("%a, %b %d, %Y")
                time_str = "N/A"
                all_day = "✓"
            else:
                # Format the date and time for timed events
                date_obj = datetime.datetime.fromisoformat(start.replace("Z", "+00:00"))
                date_str = date_obj.strftime("%a, %b %d, %Y")
                time_str = date_obj.strftime("%I:%M %p")
                all_day = "✗"

            table.add_row(
                date_str,
                time_str,
                event["summary"],
                event.get("calendarName", "Primary"),
                all_day,
            )

        self.console.print(table)


    def add_all_day_event(self, summary, date_str=None, calendar_id=None):
        """Add a new all-day event to the specified calendar."""
        service = self.service

        if not calendar_id:
            # Get list of calendars and let user choose
            calendars = self.get_calendar_list()
            self.display_calendars(calendars)

            calendar_num = IntPrompt.ask(
                "Select calendar number to add event to", default=1, show_choices=False
            )

            if calendar_num < 1 or calendar_num > len(calendars):
                self.console.print("[bold red]Invalid calendar number.[/]")
                return False

            calendar_id = calendars[calendar_num - 1]["id"]
            calendar_name = calendars[calendar_num - 1]["summary"]
            self.console.print(f"Adding event to [green]{calendar_name}[/]")

        if not date_str:
            # Use tomorrow as the default date if none provided
            date_obj = datetime.datetime.now().date() + datetime.timedelta(days=1)
        else:
            # Parse the provided date string (expecting format YYYY-MM-DD)
            try:
                date_obj = datetime.datetime.strptime(date_str, "%Y-%m-%d").date()
            except ValueError:
                self.console.print("[bold red]Invalid date format. Please use YYYY-MM-DD.[/]")
                return False

        # Create the event body
        event = {
            "summary": summary,
            "start": {
                "date": date_obj.isoformat(),
            },
            "end": {
                "date": date_obj.isoformat(),
            },
        }

        # Add the event to the calendar
        event = service.events().insert(calendarId=calendar_id, body=event).execute()
        self.console.print(f"[bold green]✓ Event created: {event.get('htmlLink')}[/]")
        return True


    def main_menu(self):
        """Display the main menu and handle user input."""
        while True:
            self.console.print(
                Panel.fit(
                    "[bold cyan]Google Calendar Agenda App[/]\n\n"
                    + "[1] View all calendars\n"
                    + "[2] View upcoming events from all calendars\n"
                    + "[3] View upcoming events from a specific calendar\n"
                    + "[4] Add new all-day event\n"
                    + "[Q] Exit",
                    title="gCal",
                    border_style="blue",
                )
            )

            choice = self.console.input("[bold]Enter your choice: [/]")

            if choice == "1":
                calendars = self.get_calendar_list()
                self.display_calendars(calendars)

            if choice == "2":
                events = self.get_all_events(self.days)
                self.display_events(events)

            elif choice == "3":
                calendars = self.get_calendar_list()
                self.display_calendars(calendars)

                calendar_num = IntPrompt.ask(
                    "Select calendar number", default=1, show_choices=False
                )

                if calendar_num < 1 or calendar_num > len(calendars):
                    self.console.print("[bold red]Invalid calendar number.[/]")
                    continue

                calendar_id = calendars[calendar_num - 1]["id"]
                days = self.console.input("[bold]Enter number of days to show (default: 7): [/]")
                days = int(days) if days.isdigit() else 7

                events = self.get_events(days, calendar_id)
                for event in events:
                    event["calendarName"] = calendars[calendar_num - 1]["summary"]

                self.display_events(events)

            elif choice == "4":
                summary = self.console.input("[bold]Enter event title: [/]")
                date_str = self.console.input(
                    "[bold]Enter date (YYYY-MM-DD, leave empty for tomorrow): [/]"
                )

                if summary:
                    self.add_all_day_event(summary, date_str)
                else:
                    self.console.print("[bold red]Event title cannot be empty![/]")

            elif choice == "q" or choice == "Q":
                self.console.print(
                    "[bold green]Thank you for using Google Calendar Agenda App. Goodbye![/]"
                )
                break

            else:
                self.console.print("[bold red]Invalid choice. Please try again.[/]")

            self.console.input("\n[italic]Press Enter to continue...[/]")
            self.console.clear()


if __name__ == "__main__":
    app = App()

    app.console.clear()
    app.console.print()

    try:
        app.main_menu()
    except Exception as e:
        app.console.print(f"[bold red]An error occurred: {str(e)}[/]")

#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#    "questionary>=2.1.0",
#    "todoist-api-python>=2.1.7",
#    "typer>=0.15.1",
# ]
# ///

import os
import typer
from rich.console import Console
import questionary
from rich.table import Table
from todoist_api_python.api import TodoistAPI


# Initialize our main application components
app = typer.Typer()
console = Console()

api = TodoistAPI(os.getenv("TODOIST_API_KEY", ""))


def validate_api_key() -> bool:
    """Validate that the API key is set and working"""
    try:
        api.get_projects()
        return True
    except Exception:
        console.print("[red]Error: Invalid or missing API key[/red]")
        console.print("Please set your TODOIST_API_KEY environment variable")
        return False

@app.command()
def list():
    """List all active tasks"""
    if not validate_api_key():
        return

    try:
        # Get all active tasks
        tasks = api.get_tasks()
        
        # Create a rich table for better visualization
        table = Table(show_header=True, header_style="bold magenta")
        table.add_column("ID", style="dim")
        table.add_column("Task")
        table.add_column("Project")
        table.add_column("Due")
        table.add_column("Priority")
        
        # Add all tasks to the table
        for task in tasks:
            project = api.get_project(task.project_id)
            table.add_row(
                task.id,
                task.content,
                project.name,
                task.due.date if task.due else "No due date",
                str(task.priority)
            )
        
        console.print(table)

    except Exception as e:
        console.print(f"[red]Error: {str(e)}[/red]")

@app.command()
def add():
    """Add a new task interactively"""
    if not validate_api_key():
        return

    try:
        # Get all projects for selection
        projects = api.get_projects()
        project_choices = [{"name": p.name, "value": p.id} for p in projects]

        # Get task details through interactive prompts
        task_content = questionary.text("What is the task?").ask()
        project_id = questionary.select(
            "Select project:",
            choices=project_choices
        ).ask()
        
        due_date = questionary.text(
            "Due date (empty for none, or format like 'tomorrow', 'next monday'):"
        ).ask()
        
        priority = questionary.select(
            "Select priority:",
            choices=[
                {"name": "Priority 1 (Highest)", "value": 4},
                {"name": "Priority 2", "value": 3},
                {"name": "Priority 3", "value": 2},
                {"name": "Priority 4 (Lowest)", "value": 1}
            ]
        ).ask()

        # Create the task
        task = api.add_task(
            content=task_content,
            project_id=project_id,
            due_string=due_date if due_date else None,
            priority=priority
        )

        console.print("[green]Task added successfully![/green]")
        
    except Exception as e:
        console.print(f"[red]Error: {str(e)}[/red]")

@app.command()
def complete(task_id: str):
    """Complete a task by its ID"""
    if not validate_api_key():
        return

    try:
        api.close_task(task_id)
        console.print("[green]Task completed successfully![/green]")
    except Exception as e:
        console.print(f"[red]Error: {str(e)}[/red]")

@app.command()
def delete(task_id: str):
    """Deletes a task by its ID"""
    if not validate_api_key():
        return

    try:
        api.delete_task(task_id)
        console.print("[green]Task deleted successfully![/green]")
    except Exception as e:
        console.print(f"[red]Error: {str(e)}[/red]")

@app.command()
def projects():
    """List all projects"""
    if not validate_api_key():
        return

    try:
        projects = api.get_projects()
        
        table = Table(show_header=True, header_style="bold magenta")
        table.add_column("ID", style="dim")
        table.add_column("Name")
        table.add_column("Task Count")
        
        for project in projects:
            # Get task count for each project
            tasks = api.get_tasks(project_id=project.id)
            table.add_row(
                project.id,
                project.name,
                str(len(tasks))
            )
            
        console.print(table)
        
    except Exception as e:
        console.print(f"[red]Error: {str(e)}[/red]")

if __name__ == "__main__":
    app.callback()(lambda: None)
    app()

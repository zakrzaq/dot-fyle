#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "httpx>=0.28.1",
#     "asyncio>=3.4.3",
#     "rich>=14.0.0",
# ]
# ///


import os
import datetime
import httpx
import asyncio
import signal
from rich.console import Console
from rich.text import Text

stop_event = asyncio.Event()


def signal_handler():
    asyncio.create_task(stop_event.set())


async def quote_me_happy():
    constants = {
            "API_URL": "https://qapi.vercel.app/api/random",
            "USER": os.getenv("USER", "user").capitalize(),
            "DATE": datetime.datetime.now().strftime("%A, %d-%m-%Y")
            }

    while not stop_event.is_set():
        r = httpx.get(constants["API_URL"])
        _, quote, author = r.json().values()

        console = Console()
        terminal_height = console.height

        quote_text = Text(quote, style="bold italic cyan")
        author_text = Text(f"- {author}", style="bold magenta")

        console.clear()
        console.print(f"\nTop of the morning {constants['USER']}!", justify="center")
        console.print(f"\n{constants["DATE"]}", justify="center")
        console.print("\n" * (terminal_height // 2 - 5))
        console.print(quote_text, justify="center")
        console.print(author_text, justify="center")
        console.print("\n" * (terminal_height // 2 - 3))

        await asyncio.sleep(60)


async def main():
    loop = asyncio.get_running_loop()
    loop.add_signal_handler(signal.SIGINT, signal_handler)

    task = asyncio.create_task(quote_me_happy())  # Run task in background
    await stop_event.wait()  # Wait for stop signal
    task.cancel()
    
    try:
        await task  # Ensure task finishes properly
    except asyncio.CancelledError:
        print("Task was cancelled.")

    print("Shutdown complete.")
    task = asyncio.create_task(quote_me_happy())  # Run in the background
    await task


if __name__ == "__main__":
  asyncio.run(main())


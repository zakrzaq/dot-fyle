#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "yt-dlp",
#     "pyperclip",
#     "tqdm",
# ]
# ///

import sys
import re
from pathlib import Path
import pyperclip  # type: ignore
from yt_dlp import YoutubeDL  # type: ignore
from tqdm import tqdm

# Setup paths
HOME_DIR = Path.home()
DOWNLOAD_DIR = HOME_DIR / 'Downloads' / 'yt-dlp'
DOWNLOAD_DIR.mkdir(parents=True, exist_ok=True)

# Initialize tqdm progress bar (will be updated in the hook)
pbar = None

def progress_hook(d):
    global pbar

    if d['status'] == 'downloading':
        total_bytes = d.get('total_bytes') or d.get('total_bytes_estimate')
        downloaded = d.get('downloaded_bytes', 0)

        if total_bytes and not pbar:
            pbar = tqdm(total=total_bytes, unit='B', unit_scale=True, desc=d['filename'], ncols=100)

        if pbar and total_bytes:
            pbar.update(downloaded - pbar.n)

    elif d['status'] == 'finished':
        if pbar:
            pbar.close()
            print(f"\n✅ Download complete: {d['filename']}")
            pbar = None

def download_mp3(url, output_folder=DOWNLOAD_DIR):
    ydl_opts = {
        'format': 'bestaudio/best',
        'outtmpl': str(output_folder / '%(title)s.%(ext)s'),
        'postprocessors': [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'mp3',
            'preferredquality': '192',
        }],
        'progress_hooks': [progress_hook],
        'quiet': True,
        'noplaylist': True,
    }

    print(f"\n🎵 Processing: {url}")
    with YoutubeDL(ydl_opts) as ydl:
        try:
            ydl.download([url])
        except Exception as e:
            print(f"❌ Failed to download {url}: {e}")

def main():
    clipboard = pyperclip.paste()

    if clipboard:
        urls = [line.strip() for line in clipboard.splitlines() if re.match(r'^https?://', line.strip())]
    else:
        urls = [arg.strip() for arg in sys.argv[1:] if re.match(r'^https?://', arg.strip())]

    if not urls:
        print("🚫 No valid URLs found in clipboard or arguments.")
        return

    for url in urls:
        download_mp3(url)

if __name__ == "__main__":
    main()

#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#    "httpx>=0.21.3",
# ]
# ///


import httpx
import typing as t

# Configuration for the CLI client
SERVER_URL = "http://localhost:7070" # Matches the server's default port

async def get_available_providers() -> t.List[str]:
    """
    Fetches the list of available providers from the server.
    """
    try:
        async with httpx.AsyncClient() as client:
            # We don't have a direct endpoint for listing *all* providers,
            # but we can infer them from the server's internal configuration
            # or by trying to fetch models for known providers.
            # For simplicity, we'll hardcode the known providers here,
            # which should match the server's Provider Enum.
            return ["openai", "gemini", "anthropic", "deepseek", "ollama"]
    except httpx.RequestError as e:
        print(f"Error connecting to server to get providers: {e}")
        return []

async def fetch_models_from_server(provider_name: str) -> t.List[str]:
    """
    Fetches available models for a given provider from the server.
    """
    try:
        async with httpx.AsyncClient() as client:
            response = await client.get(f"{SERVER_URL}/models", params={"provider": provider_name})
            response.raise_for_status()
            return response.json().get("models", [])
    except httpx.HTTPStatusError as e:
        print(f"Error fetching models for {provider_name}: {e.response.status_code}, {e.response.text}")
        return []
    except httpx.RequestError as e:
        print(f"Error connecting to server to get models: {e}")
        return []

async def send_chat_message(provider: str, model: str, message: str, session_id: str) -> str:
    """
    Sends a chat message to the server and returns the response.
    """
    payload = {
        "provider": provider,
        "model": model,
        "message": message,
        "session_id": session_id,
    }
    try:
        async with httpx.AsyncClient() as client:
            response = await client.post(f"{SERVER_URL}/chat", json=payload)
            response.raise_for_status()
            return response.json().get("response", "No response from LLM.")
    except httpx.HTTPStatusError as e:
        error_detail = e.response.json().get("error", "Unknown server error")
        print(f"Server error: {e.response.status_code} - {error_detail}")
        return f"Error: {error_detail}"
    except httpx.RequestError as e:
        print(f"Error connecting to server: {e}")
        return f"Error: Could not connect to server at {SERVER_URL}"

async def main():
    """
    Main function for the CLI chat application.
    """
    print("Welcome to the Multi-LLM Chat CLI!")

    session_id = input("Enter a session ID (e.g., my_chat_session): ").strip()
    if not session_id:
        print("Session ID cannot be empty. Exiting.")
        return

    while True:
        providers = await get_available_providers()
        if not providers:
            print("No LLM providers available. Please ensure the server is running and configured correctly.")
            break

        print(f"\nAvailable Providers: {', '.join(providers)}")
        chosen_provider = input("Choose a provider: ").strip().lower()

        if chosen_provider not in providers:
            print("Invalid provider. Please choose from the available list.")
            continue

        models = await fetch_models_from_server(chosen_provider)
        if not models:
            print(f"No models found for {chosen_provider}. Please check server logs or API keys.")
            continue

        print(f"\nAvailable Models for {chosen_provider}: {', '.join(models)}")
        chosen_model = input("Choose a model: ").strip()

        if chosen_model not in models:
            print("Invalid model. Please choose from the available list.")
            continue

        user_message = input("You: ").strip()
        if not user_message:
            print("Message cannot be empty.")
            continue

        print(f"Sending message to {chosen_provider} ({chosen_model})...")
        llm_response = await send_chat_message(chosen_provider, chosen_model, user_message, session_id)
        print(f"LLM: {llm_response}")

        if input("\nContinue chatting? (yes/no): ").strip().lower() != 'yes':
            break

if __name__ == "__main__":
    import asyncio
    asyncio.run(main())

#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = [
#   "pyperclip>=1.9.0",
#   "requests>=2.32.3",
#   "rich>=14.0.0",
# ]
# ///


import requests
import argparse
import sys
import pyperclip
from rich.console import Console
from rich.panel import Panel
from rich.text import Text

console = Console()


def create_tiny_url(long_url):
    """Generate a short URL using TinyURL's API"""
    try:
        api_url = f"https://tinyurl.com/api-create.php?url={long_url}"
        response = requests.get(api_url)

        if response.status_code == 200:
            return response.text
        else:
            return f"Error: Unable to generate tiny URL. Status code: {response.status_code}"
    except Exception as e:
        return f"Error: {str(e)}"


def main():
    parser = argparse.ArgumentParser(
        description="Generate tiny URLs from the command line"
    )
    parser.add_argument("url", nargs="?", help="The long URL to shorten")
    parser.add_argument(
        "-c", "--clipboard", action="store_true", help="Copy the tiny URL to clipboard"
    )
    args = parser.parse_args()

    if args.url:
        long_url = args.url
    else:
        console.print(Panel("Tiny URL Generator", style="bold green"))
        long_url = console.input("[bold blue]Enter the URL to shorten:[/] ")

    console.print("\n[bold yellow]Generating tiny URL...[/]")
    tiny_url = create_tiny_url(long_url)

    if tiny_url.startswith("Error"):
        console.print(f"[bold red]{tiny_url}[/]")
        return

    result_text = Text.from_markup(
        f"[bold green]Original:[/] {long_url}\n[bold green]Tiny URL:[/] {tiny_url}"
    )
    console.print(Panel(result_text, title="Success!", border_style="green"))

    if args.clipboard:
        try:
            pyperclip.copy(tiny_url)
            console.print("[bold green]✓ Copied to clipboard![/]")
        except Exception:
            console.print(
                "[bold yellow]Could not copy to clipboard. You may need to install pyperclip dependencies.[/]"
            )

    # elif console.input("\n[bold blue]Copy to clipboard? (y/n):[/] ").lower() == "y":
    try:
        pyperclip.copy(tiny_url)
        console.print("[bold green]✓ Copied to clipboard![/]")
    except Exception:
        console.print(
            "[bold yellow]Could not copy to clipboard. You may need to install pyperclip dependencies.[/]"
        )


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        console.print("\n[bold red]Operation cancelled by user.[/]")
        sys.exit(0)

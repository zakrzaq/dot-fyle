#!/bin/bash

# Default messages
MESSAGE="Task completed"
ERR_MESSAGE="Task failed"

# Flags to include stdout/stderr
INCLUDE_STDOUT=false
INCLUDE_STDERR=false

# Parse options using getopts
while getopts "oe" opt; do
  case "$opt" in
    o)
      INCLUDE_STDOUT=true
      ;;
    e)
      INCLUDE_STDERR=true
      ;;
    \?)
      echo "Invalid option: -$OPTARG" >&2
      exit 1
      ;;
    :)
      echo "Option -$OPTARG requires an argument." >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND -1))

# Check if a command is provided
if [ $# -eq 0 ]; then
  echo "Usage: $0 [-o] [-e] <command> [success_message] [failure_message]"
  exit 1
fi

# Construct the command string
CMD="$1"
shift
COMMAND="$CMD $@"

MESSAGE="$1"
shift
ERR_MESSAGE="$1"
shift

# Execute command and capture stdout/stderr
# set -x # DEBUG: uncomment this line for tracing
echo "Executing command: $COMMAND" >&2 # DEBUG: added logging
OUTPUT=$(eval "$COMMAND 2>&1 | tee /dev/stderr")
EXIT_CODE=$?

echo "Command output: $OUTPUT" >&2 # DEBUG: added logging
echo "Exit code: $EXIT_CODE" >&2 # DEBUG: added logging

# Construct message
if [ "$EXIT_CODE" -eq 0 ]; then
  MESSAGE="FINISHED: $MESSAGE"
  if $INCLUDE_STDOUT; then
    MESSAGE="$MESSAGE\nSTDOUT: $OUTPUT"
  fi
else
  ERR_MESSAGE="FAILED: $ERR_MESSAGE"
  if $INCLUDE_STDERR; then
    ERR_MESSAGE="$ERR_MESSAGE\nSTDERR: $OUTPUT"
  fi
fi

# Send notification
if [ "$EXIT_CODE" -eq 0 ]; then
  notify-telegram -message "$MESSAGE"
  else
    notify-telegram -message "$ERR_MESSAGE"
  fi

exit "$EXIT_CODE"
  ERR_MESSAGE="FAILED: $ERR_MESSAGE"
  if $INCLUDE_STDERR; then
    ERR_MESSAGE="$ERR_MESSAGE\nSTDERR: $OUTPUT"
  fi
fi

# Send notification
if [ "$EXIT_CODE" -eq 0 ]; then
  notify-telegram -message "$MESSAGE"
else
  notify-telegram -message "$ERR_MESSAGE"
fi

exit "$EXIT_CODE"
    ERR_MESSAGE="$ERR_MESSAGE\nSTDERR: $OUTPUT"
  fi
fi

# Send notification
if [ "$EXIT_CODE" -eq 0 ]; then
  notify-telegram -message "$MESSAGE"
else
  notify-telegram -message "$ERR_MESSAGE"
fi

exit "$EXIT_CODE"
else
  notify-telegram -message "$ERR_MESSAGE"
fi

exit "$EXIT_CODE"


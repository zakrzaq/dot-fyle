import sys
import logging
import argparse
import requests
import json
import time
import statistics
from dataclasses import dataclass
from typing import List, Optional, Tuple, NamedTuple
from tqdm import tqdm


@dataclass
class Config:
    DEFAULT_PROMPT: str = "Explain briefly how neural networks work."
    DEFAULT_NUM_RUNS: int = 5
    DEFAULT_MAX_TOKENS: int = 100
    DEFAULT_API_URL: str = "http://localhost:11434"
    GENERATE_ENDPOINT: str = "/api/generate"
    TAGS_ENDPOINT: str = "/api/tags"
    REQUEST_TIMEOUT: int = 60
    FETCH_TIMEOUT: int = 10

class ModelManager:
    def __init__(self, base_api_url: str):
        self.base_api_url = base_api_url.rstrip("/")

    def fetch_models(self) -> Optional[List[str]]:
        tags_url = f"{self.base_api_url}{Config.TAGS_ENDPOINT}"
        try:
            response = requests.get(tags_url, timeout=Config.FETCH_TIMEOUT)
            response.raise_for_status()
            data = response.json()
            models = data.get("models", [])
            return sorted(model["name"] for model in models)
        except (requests.exceptions.RequestException, json.JSONDecodeError, KeyError) as e:
            logging.error(f"Error fetching models: {type(e).__name__} - {e}")
            return None

    def select_model(self, models: List[str]) -> Optional[str]:
        print("\nAvailable models:")
        for i, model in enumerate(models, 1):
            print(f"  {i}: {model}")

        while True:
            choice_str = input(f"\nSelect a model (1-{len(models)}) or 'q' to quit: ").strip().lower()
            if choice_str == "q":
                return None
            try:
                choice = int(choice_str)
                if 1 <= choice <= len(models):
                    return models[choice - 1]
                print(f"Please enter a number between 1 and {len(models)}.")
            except ValueError:
                print("Invalid input. Please enter a number or 'q'.")


class BenchmarkResult(NamedTuple):
    run: int
    time: float
    tokens: int
    tokens_per_second: float


class BenchmarkRunner:
    def __init__(self, generate_url: str):
        self.generate_url = generate_url

    @staticmethod
    def count_tokens(text: str) -> int:
        words = text.split()
        return sum(len(word) >= 3 for word in words) + len([c for c in text if not c.isalpha()])

    def run(self, model_name: str, prompt: str, num_runs: int, max_tokens: int) -> Tuple[List[BenchmarkResult], List[int]]:
        results: List[BenchmarkResult] = []
        token_counts: List[int] = []

        print(f"\nBenchmarking {model_name} ({num_runs} runs, max_tokens={max_tokens})...")

        for i in tqdm(range(num_runs), desc="Benchmark Progress"):
            data = {
                "model": model_name,
                "prompt": prompt,
                "stream": False,
                "options": {"num_predict": max_tokens},
            }

            try:
                start_time = time.time()
                response = requests.post(self.generate_url, json=data, timeout=Config.REQUEST_TIMEOUT)
                response.raise_for_status()
                response_data = response.json()
                end_time = time.time()

                response_text = response_data["response"]
                elapsed = end_time - start_time
                token_count = self.count_tokens(response_text)
                tokens_per_second = token_count / elapsed if elapsed > 0 else float("inf")

                result = BenchmarkResult(i + 1, elapsed, token_count, tokens_per_second)
                results.append(result)
                token_counts.append(token_count)

            except Exception as e:
                logging.error(f"Run {i + 1} failed: {type(e).__name__} - {e}")

        return results, token_counts


class ResultPrinter:
    @staticmethod
    def print_results(results: List[BenchmarkResult], token_counts: List[int], model_name: str) -> None:
        if not results:
            print("No valid results to display.")
            return

        times = [r.time for r in results]
        tps_values = [r.tokens_per_second for r in results]

        print("\n===== BENCHMARK RESULTS =====")
        print(f"Model: {model_name}")
        print(f"Number of successful runs: {len(results)}")

        print("\nIndividual Runs:")
        print(f"{'Run':<5} {'Time (s)':<10} {'Tokens':<10} {'Tokens/sec':<10}")
        print("-" * 40)
        for r in results:
            print(f"{r.run:<5} {r.time:<10.2f} {r.tokens:<10} {r.tokens_per_second:.2f}")

        if times:
            ResultPrinter._print_statistics(times, tps_values, token_counts)

    @staticmethod
    def _print_statistics(times: List[float], tps_values: List[float], token_counts: List[int]) -> None:
        print("\nSummary Statistics:")
        print(f"Average response time: {statistics.mean(times):.2f}s")
        print(f"Fastest response time: {min(times):.2f}s")
        print(f"Slowest response time: {max(times):.2f}s")
        print(f"Average tokens per second: {statistics.mean(tps_values):.2f}")
        print(f"Average token count: {statistics.mean(token_counts):.0f}")
        print("===========================")


def main() -> None:
    logging.basicConfig(
        stream=sys.stderr,
        level=logging.ERROR,
        format='%(asctime)s - %(levelname)s - %(message)s'
    )

    parser = argparse.ArgumentParser(description="Benchmark Ollama models via the HTTP API.")
    parser.add_argument("--model", dest="model_name", help="Name of the Ollama model to benchmark")
    parser.add_argument("--runs", type=int, default=Config.DEFAULT_NUM_RUNS,
                       help=f"Number of runs (default: {Config.DEFAULT_NUM_RUNS})")
    parser.add_argument("--tokens", type=int, default=Config.DEFAULT_MAX_TOKENS,
                       help=f"Maximum tokens to generate (default: {Config.DEFAULT_MAX_TOKENS})")
    parser.add_argument("--prompt", default=Config.DEFAULT_PROMPT,
                       help="Prompt to use for benchmarking")
    parser.add_argument("--api-url", default=Config.DEFAULT_API_URL,
                       help=f"Base URL of the Ollama API (default: {Config.DEFAULT_API_URL})")

    args = parser.parse_args()
    base_api_url = args.api_url.rstrip("/")
    generate_url = base_api_url + Config.GENERATE_ENDPOINT

    model_manager = ModelManager(base_api_url)
    selected_model = args.model_name

    if not selected_model:
        print("Fetching available models...")
        available_models = model_manager.fetch_models()
        if not available_models:
            sys.exit("Could not fetch models or no models available.")
        selected_model = model_manager.select_model(available_models)
        if not selected_model:
            sys.exit("No model selected. Exiting.")

    benchmark = BenchmarkRunner(generate_url)
    results, token_counts = benchmark.run(selected_model, args.prompt, args.runs, args.tokens)
    ResultPrinter.print_results(results, token_counts, selected_model)

if __name__ == "__main__":
    main()

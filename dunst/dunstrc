[global]
    monitor = 1
    follow = mouse
    width = 300
    height = 100
    offset = 10x50
    transparency = 10
    padding = 10
    horizontal_padding = 10
    frame_width = 2
    frame_color = "#81A1C1"
    separator_color = auto
#    font = FiraCode Nerd Font 10
    font = Hack Nerd Font Mono 10
    line_height = 3
    corner_radius = 5

[urgency_low]
    background = "#2E3440"
    foreground = "#D8DEE9"
    frame_color = "#81A1C1"

[urgency_normal]
    background = "#2E3440"
    foreground = "#D8DEE9"
    frame_color = "#88C0D0"

[urgency_critical]
    background = "#2E3440"
    foreground = "#D8DEE9"
    frame_color = "#BF616A"


#### JAKE ####

# font pango:FiraCode Nerd Font Light 10
font pango:Hack Nerd Font Mono 10

gaps inner 6
gaps outer 2

default_border pixel 0
default_floating_border pixel 0
for_window [class="^.*"] border pixel 0
for_window [tiling] border pixel 1
for_window [floating] border pixel 1

bindsym $mod+Ctrl+greater move workspace to output right
bindsym $mod+Ctrl+less move workspace to output left
bindsym $mod+Ctrl+m move workspace to output up
bindsym $mod+Ctrl+n move workspace to output down
bindsym Control+Shift+1 exec ~/.screenlayout/left.sh
bindsym Control+Shift+2 exec ~/.screenlayout/right.sh
bindsym Control+Shift+8 exec ~/.screenlayout/full-dock.sh
bindsym Control+Shift+9 exec ~/.screenlayout/both.sh
bindsym Control+Shift+0 exec ~/.screenlayout/none.sh

bindsym $mod+Shift+x exec i3lock -c 000000
bindsym $mod+t exec --no-startup-id ~/.local/_bin/tgl-input 17
bindsym $mod+b exec --no-startup-id ~/.local/_bin/tgl-bluetooth

bindsym $mod+Shift+i exec rofimoji --action copy
bindsym $mod+Shift+w sticky toggle 
bindsym $mod+Shift+p exec --no-startup-id maim --select | xclip -selection clipboard -t image/png
bindsym $mod+Shift+t exec --no-startup-id feh --no-fehbg --geometry +0+0 --zoom fill --fullscreen ~/Pictures/wallpapers/background.jpg

bindsym Mod1+Tab focus next
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

bindsym $mod+Shift+m exec --no-startup-id systemctl suspend
bindsym $mod+Shift+n exec --no-startup-id systemctl hibernate

bindsym $mod+Shift+a exec powerprofilesctl set power-saver
bindsym $mod+Shift+s exec powerprofilesctl set balanced
bindsym $mod+Shift+d exec powerprofilesctl set performance


